# ==============================================================================
# Daffodil DC253D Touchpad & Intel LPSS I2C Controller Power Shield
# Hardware: SYNA3602:00 (093A:0255) on Intel Serial IO I2C Controller (00:15.0)
# ==============================================================================
# Prevent the Intel Serial IO I2C controller and SYNA3602 touchpad from entering
# deep runtime power suspend, which causes missed GPIO interrupts and touchpad freezes.
ACTION=="add|change", SUBSYSTEM=="pci", ATTR{vendor}=="0x8086", ATTR{device}=="0x51c5|0x51c6|0x51e8|0x51e9", ATTR{power/control}="on"
ACTION=="add|change", SUBSYSTEM=="pci", DRIVERS=="intel-lpss", ATTR{power/control}="on"
ACTION=="add|change", SUBSYSTEM=="i2c", KERNEL=="i2c-SYNA3602:00*", ATTR{power/control}="on"
